{
  "version": 2,
  "functions": {
    "api/view.js": {
      "maxDuration": 20
    },
    "api/proxy.js": {
      "maxDuration": 20
    },
    "api/solve.js": {
      "maxDuration": 20
    },
    "api/paypal-verify.js": {
      "maxDuration": 20
    },
    "api/reveal.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/it/",
      "destination": "/it/index.html"
    },
    {
      "source": "/fr/",
      "destination": "/fr/index.html"
    },
    {
      "source": "/es/",
      "destination": "/es/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/it",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/it/index.html",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/fr",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/index.html",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/es",
      "destination": "/es/",
      "permanent": true
    },
    {
      "source": "/es/index.html",
      "destination": "/es/",
      "permanent": true
    }
  ]
}

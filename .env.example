# Tempo di attesa gratuito prima di mostrare la risposta (0-120 secondi)
ANSWER_WAIT_SECONDS=15

# Chiave privata per cifrare le risposte e firmare l’accesso Premium.
# Generane una lunga e casuale, diversa dalle credenziali PayPal.
MONETIZATION_SECRET=

# PayPal Subscriptions
# Usa sandbox durante i test e live in produzione.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=

# Google AdSense opzionale. Senza questi valori appare un segnaposto pubblicitario.
ADSENSE_CLIENT_ID=ca-pub-0000000000000000
ADSENSE_SLOT_ID=0000000000
